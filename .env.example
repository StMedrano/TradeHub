APP_ENV=production
APP_NAME=TradeHub
DATABASE_URL=postgresql+psycopg://tradehub:CHANGE_ME@db:5432/tradehub
POSTGRES_PASSWORD=CHANGE_ME

TRADING_MODE=dry_run
# live_account = use synchronized Robinhood equity/buying power for risk.
# simulation = use real Robinhood market data with an isolated virtual ledger.
RISK_CAPITAL_MODE=live_account
SIMULATION_CAPITAL=10000
PHASE=0
REQUIRE_APPROVAL=true
MAX_CONCURRENT_POSITIONS=1

MAX_TRADE_LOSS_PCT=0.05
MAX_PORTFOLIO_LOSS_PCT=0.20
DAILY_LOSS_BREAKER_PCT=0.10

LIQUIDITY_MAX_SPREAD_PCT=0.10
STRATEGY_MIN_OPEN_INTEREST=500
STRATEGY_MIN_VOLUME=50
STRATEGY_MIN_DTE=21
STRATEGY_MAX_DTE=45
STRATEGY_SHORT_DELTA_MIN=0.15
STRATEGY_SHORT_DELTA_MAX=0.30
ENTRY_TIMEOUT_SECONDS=90
PRICE_WALK_INCREMENT=0.01
MAX_SLIPPAGE_PCT=0.08

ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_ENABLED=false
ROBINHOOD_SPREADS_ENABLED=false
ROBINHOOD_OAUTH_STORE=/data/robinhood_oauth.json
ROBINHOOD_OAUTH_REDIRECT_URI=http://localhost:33418/callback
ROBINHOOD_SYNC_INTERVAL_SECONDS=30

ALERT_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Comma-separated symbols for read-only account-fit scanning.
STRATEGY_WATCHLIST=
STRATEGY_WATCHLIST_MAX_SYMBOLS=5

# Whole-market discovery is disabled until explicitly enabled.
MARKET_SCANNER_ENABLED=false
MARKET_SCANNER_MAX_DEEP_SYMBOLS=100
MARKET_SCANNER_OPTION_CONCURRENCY=2
MARKET_SCANNER_PREFILTER_CONCURRENCY=4
MARKET_SCANNER_MIN_PRICE=5
MARKET_SCANNER_MIN_AVG_VOLUME=1000000
MARKET_SCANNER_MIN_MARKET_CAP=1000000000
MARKET_SCANNER_EXCLUDE_EARNINGS=true
